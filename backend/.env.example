# --- Application ---
APP_NAME="Site Bank API"
APP_VERSION="0.1.0"
ENV=dev
# Dev convenience only. Production validation rejects DEBUG=true.
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
ALLOWED_HOSTS=["*"]
# Trust X-Forwarded-For only from this proxy address/subnet. In production set
# the reverse proxy address or subnet; do not use "*" without a reason.
FORWARDED_ALLOW_IPS=127.0.0.1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3210","http://127.0.0.1:3210"]

# --- Database (PostgreSQL in docker-compose, SQLite for quick local tests) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/site_bank
DATABASE_ECHO=false

# --- Sessions & cookies ---
# The login cookie holds an opaque token; sessions live in the database.
SESSION_COOKIE_NAME=site_bank_session
SESSION_TTL_MINUTES=20160
# Leave empty to auto-enable secure cookies when ENV=prod.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# --- Storage (images, uploads) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=media
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Leads ---
LEAD_RATE_LIMIT_PER_HOUR=5
LEAD_RATE_LIMIT_PER_IP_PER_HOUR=10
# Telegram notification for new leads (both required; empty = no notification).
# Do not commit real tokens.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Salt for pseudonymizing client IPs (set a secret value in production).
IP_HASH_SALT=
