# Production environment for `compose.prod.yaml`.
# Copy to `deploy/.env.production`, replace every placeholder and never commit it.
# Usage: docker compose --env-file deploy/.env.production -f compose.prod.yaml up -d

# --- Public entrypoint ------------------------------------------------------
# A single origin serves both the site and the API through Caddy (no CORS).
SITE_DOMAIN=tutor.example.com
ACME_EMAIL=admin@example.com
# Address or subnet of the reverse proxy that may set X-Forwarded-For.
# Do not use "*" without a reason. This must match the compose network subnet.
FORWARDED_ALLOW_IPS=172.28.0.0/16

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=site_bank
POSTGRES_USER=site_bank
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Backend (FastAPI) ------------------------------------------------------
APP_NAME=Site Bank API
APP_VERSION=0.1.0
ENV=prod
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
# Comma-separated. "localhost" and "127.0.0.1" are needed by the container healthcheck.
ALLOWED_HOSTS=tutor.example.com,localhost,127.0.0.1,api
CORS_ORIGINS=https://tutor.example.com

# DATABASE_URL is assembled by compose.prod.yaml from POSTGRES_*.
DATABASE_ECHO=false

SESSION_COOKIE_NAME=site_bank_session
SESSION_TTL_MINUTES=20160
# Leave empty to force secure cookies automatically in production.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.tutor.example.com

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=media
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

LEAD_RATE_LIMIT_PER_HOUR=5
LEAD_RATE_LIMIT_PER_IP_PER_HOUR=10
# Public self-registration stays disabled; create the admin via scripts/create_admin.py.
REGISTRATION_ENABLED=false

# Required in production: at least 16 random characters.
# Generate: openssl rand -hex 32
IP_HASH_SALT=change-me-with-openssl-rand-hex-32

# Both values are required to enable Telegram notifications; leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Frontend (Next.js) -----------------------------------------------------
# Public, same-origin API URL. The /api/v1 prefix is appended by the frontend.
NEXT_PUBLIC_SITE_URL=https://tutor.example.com
NEXT_PUBLIC_API_BASE_URL=https://tutor.example.com
# Internal URL used by server rendering inside the compose network.
API_BASE_URL=http://api:8000

# Required in production by `pnpm check:deploy`.
NEXT_PUBLIC_TUTOR_NAME=<имя репетитора>
NEXT_PUBLIC_TUTOR_ABOUT=<короткое описание репетитора>
# At least one contact channel is required: API, Telegram or e-mail.
NEXT_PUBLIC_TUTOR_TELEGRAM=@username
NEXT_PUBLIC_TUTOR_EMAIL=tutor@example.com
NEXT_PUBLIC_TUTOR_PHOTO=
NEXT_PUBLIC_TUTOR_VIDEO=

# Yandex Metrika counter id; leave empty to disable analytics and its CSP domains.
NEXT_PUBLIC_YM_ID=
