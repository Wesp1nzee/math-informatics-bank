{
	email {$ACME_EMAIL}
}

www.{$SITE_DOMAIN} {
	log {
		output stdout
		format console
	}
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	log {
		output stdout
		format console
	}
	encode zstd gzip

	@backend path /api/* /health
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
