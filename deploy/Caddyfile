{
	email {$ACME_EMAIL}
}

www.{$SITE_DOMAIN} {
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers delete
				resp_headers delete
			}
		}
	}
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers delete
				resp_headers delete
			}
		}
	}
	encode zstd gzip

	@backend path /api/* /health
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
