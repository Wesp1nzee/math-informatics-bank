{
  "version": 2,
  "blocks": [
    {
      "id": "intro",
      "type": "rich_text",
      "data": {
        "kind": "paragraph",
        "children": [
          { "type": "text", "text": "Парабола " },
          { "type": "math", "tex": "f(x)=ax^2+b" },
          { "type": "text", "text": " меняет форму в зависимости от коэффициентов. Двигайте ползунки, чтобы увидеть, как параметры влияют на график." }
        ]
      }
    },
    {
      "id": "graph-1",
      "type": "interactive_graph",
      "data": {
        "engine": "svg",
        "expressions": [
          { "id": "f", "expr": "a*x^2 + b", "label": "f(x)", "color": "#1f6feb" }
        ],
        "parameters": [
          { "id": "a", "label": "a", "min": -3, "max": 3, "step": 0.5, "default": 1 },
          { "id": "b", "label": "b", "min": -5, "max": 5, "step": 0.5, "default": 0 }
        ],
        "viewport": { "x_min": -5, "x_max": 5, "y_min": -5, "y_max": 5 },
        "interactions": ["pan", "zoom", "trace"]
      }
    },
    {
      "id": "math-vertex",
      "type": "math",
      "data": {
        "tex": "x_{\\text{вершина}} = 0, \\quad f(0) = b",
        "display": true,
        "caption": "Вершина параболы при b = 0"
      }
    },
    {
      "id": "callout-a",
      "type": "callout",
      "data": {
        "kind": "info",
        "title": "На что смотреть",
        "body": [
          { "type": "text", "text": "Знак " },
          { "type": "math", "tex": "a" },
          { "type": "text", "text": " задаёт направление ветвей, а " },
          { "type": "math", "tex": "b" },
          { "type": "text", "text": " — сдвиг по вертикали." }
        ]
      }
    },
    {
      "id": "p-try",
      "type": "rich_text",
      "data": {
        "kind": "paragraph",
        "children": [
          { "type": "text", "text": "Поставьте " },
          { "type": "math", "tex": "a < 0" },
          { "type": "text", "text": " и проследите, как ветви разворачиваются вниз." }
        ]
      }
    }
  ]
}
