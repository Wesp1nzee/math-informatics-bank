{
  "version": 2,
  "blocks": [
    {
      "id": "intro",
      "type": "rich_text",
      "data": {
        "kind": "paragraph",
        "children": [
          { "type": "text", "text": "В заданиях ЕГЭ по информатике часто дан фрагмент программы, и нужно понять, что она вычисляет. Это отдельный навык: не писать код, а читать его — спокойно и по шагам." }
        ]
      }
    },
    {
      "id": "h-start",
      "type": "rich_text",
      "data": {
        "kind": "heading",
        "level": 2,
        "children": [ { "type": "text", "text": "Начните с входа и выхода" } ]
      }
    },
    {
      "id": "p-io",
      "type": "rich_text",
      "data": {
        "kind": "paragraph",
        "children": [
          { "type": "text", "text": "Прежде чем разбирать тело цикла, найдите, что подаётся на вход и что печатается в конце. Часто этого достаточно, чтобы понять тип задачи: " },
          { "type": "strong", "children": [ { "type": "text", "text": "подсчёт" } ] },
          { "type": "text", "text": ", перебор или накопление суммы." }
        ]
      }
    },
    {
      "id": "callout-code",
      "type": "callout",
      "data": {
        "kind": "tip",
        "title": "Приём",
        "body": [
          { "type": "text", "text": "Выписывайте значения переменных после каждой итерации. Для примера используйте " },
          { "type": "code", "text": "n = 3" },
          { "type": "text", "text": " — закономерность видна уже на третьем шаге." }
        ]
      }
    },
    {
      "id": "list-steps",
      "type": "rich_text",
      "data": {
        "kind": "list",
        "ordered": true,
        "items": [
          [ { "type": "text", "text": "Определите начальные значения переменных." } ],
          [ { "type": "text", "text": "Пройдите цикл вручную для двух-трёх итераций." } ],
          [ { "type": "text", "text": "Сформулируйте, что меняется на каждой итерации." } ]
        ]
      }
    },
    {
      "id": "div-1",
      "type": "divider",
      "data": { "variant": "spaced" }
    },
    {
      "id": "img-flow",
      "type": "image",
      "data": {
        "src": "/media/informatika/reading-code.png",
        "alt": "Схема чтения программы: вход, цикл, выход",
        "caption": "Три точки, с которых начинается чтение программы",
        "width": 800,
        "height": 450
      }
    },
    {
      "id": "p-outro",
      "type": "rich_text",
      "data": {
        "kind": "paragraph",
        "children": [
          { "type": "text", "text": "Чтение кода растёт от практики. Возьмите короткую программу и перескажите её словами — что она делает, для каких входов и что вернёт." },
          { "type": "link", "href": "/zadachi?subject=informatika", "children": [ { "type": "text", "text": "Перейти к задачам по информатике" } ] }
        ]
      }
    }
  ]
}
