# Public site URL. Used for canonical links, sitemap and Open Graph metadata.
# For local development the default below is used when the variable is absent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tutor identity -------------------------------------------------------
# The original prototype contained placeholder values ("Имя Фамилия",
# "@username (добавить)"). They are intentionally NOT hard-coded anymore.
# Fill these with real data before publishing. While they are empty the UI
# hides the corresponding blocks instead of showing fake contacts.
NEXT_PUBLIC_TUTOR_NAME=
# Accepts "@username" or a full https://t.me/... link.
NEXT_PUBLIC_TUTOR_TELEGRAM=
NEXT_PUBLIC_TUTOR_EMAIL=
# Optional: path or absolute URL to the teacher photo.
NEXT_PUBLIC_TUTOR_PHOTO=
# Optional: link to an introduction video.
NEXT_PUBLIC_TUTOR_VIDEO=
# Required together with the name for the teacher block to appear. Separate
# lines with "\n" (a real newline) to get multiple paragraphs.
NEXT_PUBLIC_TUTOR_ABOUT=

# --- Analytics ------------------------------------------------------------
# Yandex Metrika counter id. The tag is loaded only when this is set; without
# it analytics calls are no-ops.
NEXT_PUBLIC_YM_ID=

# --- Future FastAPI backend ----------------------------------------------
# Base URL used by server-side requests (SSR / build / server actions).
# Never expose secrets in variables prefixed with NEXT_PUBLIC_.
API_BASE_URL=
# Base URL used by browser requests. Only put a public origin here.
NEXT_PUBLIC_API_BASE_URL=
